<?xml version="1.0" encoding="utf-8"?>
<!-- 信任系统 CA；游戏镜像均为 HTTPS（BMCL / Mojang / MCIM） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
